{
	"id": "hongguo-player",
	"name": "%plugin.name%",
	"version": "0.1.2",
	"description": "%plugin.description%",
	"defaultLocale": "zh",
	"pluginApiVersion": "^2.11.0",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "hongguo_player",
		"expose": "./plugin"
	},
	"styles": [
		"dist/style.css"
	],
	"permissions": [
		"ui.slot.workspace-view",
		"agent.skills.control",
		"agent.tools.register",
		"agent.toolHandler.execute",
		"system.processes.manage",
		"shell.openPath",
		"fs.read",
		"fs.write",
		"fs.managed",
		"network.fetch"
	],
	"commands": [],
	"platforms": [
		"win32"
	],
	"agent": {
		"skillPaths": [
			"agent/skills/hongguo-player"
		],
		"skillPresentation": {
			"defaultVisibility": "hidden",
			"skills": {
				"hongguo-player": {
					"defaultVisibility": "visible",
					"displayName": "%plugin.skillName%",
					"displayDescription": "%plugin.skillDescription%"
				}
			}
		}
	},
	"icon": "assets/icon.png",
	"fs": {
		"scopes": [
			"%APPDATA%/hgplayer",
			"%APPDATA%/hongguo-player"
		]
	},
	"network": {
		"allowedHosts": [
			"r2.youth.huxiaojia.cloud"
		]
	}
}
